# Example nginx site for Thei. Copy to /etc/nginx/sites-available/thei,
# replace example.com, then:
#
#   ln -s /etc/nginx/sites-available/thei /etc/nginx/sites-enabled/thei
#   nginx -t && systemctl reload nginx
#   certbot --nginx -d example.com
#
# Certbot rewrites this file to add the TLS listener and the HTTP redirect.

server {
    listen 80;
    listen [::]:80;
    server_name example.com;

    # Media uploads. Raise this if you work with large video files.
    client_max_body_size 512M;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Uploads and media processing can take a while.
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;

        # Thei streams media; buffering it would add latency for no gain.
        proxy_buffering off;
    }
}
