{
  "name": "thei",
  "version": "0.0.7",
  "description": "🗃️ Digital archive of your life — a résumé and a diary in one place.",
  "license": "MIT",
  "author": "Gwynerva",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gwynerva/thei.git"
  },
  "type": "module",
  "main": "./nuxt.config.ts",
  "scripts": {
    "ffmpeg": "bun update/ffmpeg/cli.ts",
    "dev": "bun scripts/dev-server.ts playground",
    "dev:realdata": "bun scripts/dev-server.ts realdata",
    "build": "nuxt build .playground",
    "start": "nuxt start .playground",
    "test": "bun vitest",
    "test:types": "bun vitest run --typecheck.enabled --typecheck.only --typecheck.tsconfig tests/tsconfig.types.json",
    "test:e2e": "bunx playwright test --config=tests/e2e/playwright.config.ts",
    "e2e:dev": "bun scripts/dev-server.ts fixture",
    "e2e:serve": "bun scripts/dev-server.ts fixture --build",
    "test:release": "bun tests/release/run.ts",
    "lab": "bun tests/lab/cli.ts",
    "og:gallery": "OG_GALLERY=1 bun vitest run tests/server/og/gallery.test.ts",
    "bench:media": "THEI_MEDIA_BENCH=1 bun vitest run tests/bench/media.test.ts",
    "bench:media:docker": "bun tests/bench/docker.ts",
    "typecheck": "nuxt typecheck .playground --checker golar",
    "format": "prettier --write .",
    "db:push": "drizzle-kit push",
    "db:baseline": "bun update/scripts/generate-baseline.mts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "@editorjs/editorjs": "2.31.7",
    "@editorjs/header": "2.8.9",
    "@editorjs/list": "2.0.9",
    "@editorjs/quote": "2.7.6",
    "@floating-ui/vue": "2.0.1",
    "@fontsource-variable/noto-sans": "5.3.0",
    "@fontsource-variable/noto-serif": "5.3.0",
    "@fontsource/noto-sans": "5.3.0",
    "@modelcontextprotocol/server": "2.4.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/vue-virtual": "3.13.50",
    "@vuepic/vue-datepicker": "14.0.0",
    "cheerio": "1.2.0",
    "chokidar": "6.0.0",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "fflate": "0.8.3",
    "h3": "1.15.11",
    "hash-wasm": "4.12.0",
    "mdast-util-directive": "3.2.0",
    "mdast-util-from-markdown": "2.1.0",
    "mdast-util-gfm-strikethrough": "2.0.1",
    "mdast-util-gfm-task-list-item": "2.0.0",
    "mdast-util-to-markdown": "2.2.1",
    "micromark": "4.0.3",
    "micromark-extension-directive": "4.0.0",
    "micromark-extension-gfm-autolink-literal": "2.1.0",
    "micromark-extension-gfm-strikethrough": "2.1.0",
    "micromark-extension-gfm-table": "2.1.2",
    "micromark-extension-gfm-task-list-item": "2.1.0",
    "oxc-transform": "0.156.0",
    "perfect-debounce": "2.1.0",
    "picocolors": "1.1.1",
    "satori": "0.63.2",
    "sharp": "0.35.5",
    "sortablejs": "1.15.7",
    "tailwindcss": "4.3.3",
    "ua-parser-js": "2.0.10",
    "unslash": "2.0.0",
    "uqr": "0.1.3",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "better-sqlite3": "^13.0.3",
    "nuxt": "^4.6.3"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@golar/vue": "0.1.10",
    "@playwright/test": "^1.64.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^25.9.9",
    "@types/sharp": "^0.32.0",
    "@types/sortablejs": "^1.15.9",
    "better-sqlite3": "13.0.3",
    "drizzle-kit": "^0.31.11",
    "golar": "0.1.10",
    "nuxt": "^4.6.3",
    "prettier": "^3.9.10",
    "prettier-plugin-classnames": "^0.10.5",
    "prettier-plugin-merge": "^0.10.2",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tar": "^7.5.22",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "yaml": "^2.9.1"
  }
}
